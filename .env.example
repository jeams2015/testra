# ============================================
# Testra — variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA commitees el .env real.
# ============================================

# --- App bajo prueba ---
APP_BASE_URL=https://demo-app.local
APP_ENV=demo

# --- PM Tool (Jira en v1.0) ---
PM_TOOL=jira
JIRA_BASE_URL=https://tu-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- LLM (Claude en v1.0) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- GitHub ---
GH_TOKEN=

# --- Notificaciones (opcional) ---
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# --- Cost gates ---
# Presupuesto máximo en USD por ticket. El orquestador pausa si se excede.
TESTRA_BUDGET_PER_TICKET=0.75
